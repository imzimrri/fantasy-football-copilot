# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only — never expose to the client. Used by cron/agent jobs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one Supabase Auth user's UUID (from auth.users), for agent/cron writes since
# there's no session to default user_id from. Set after first sign-up.
FFC_USER_ID=

# Verifies Vercel Cron requests to /api/cron/* — set the same value in Vercel's
# project environment variables.
CRON_SECRET=

# LLM access — at least one required for agents to run.
ANTHROPIC_API_KEY=
# Only needed if your key is an "identity-linked" API key (org/SSO-issued, not a
# plain sk-ant-... key) — the API rejects requests without it in that case. Find it
# at console.anthropic.com under your organization's workspace settings.
ANTHROPIC_WORKSPACE_ID=
OPENROUTER_API_KEY=

# Sleeper league/user identifiers (public API, no auth needed, but the app needs to
# know which league/user to sync).
SLEEPER_USERNAME=
SLEEPER_LEAGUE_ID=

# Perplexity Sonar API — search-grounded research step for agent reasoning (answers
# "where," not just "why"). Optional: agents degrade gracefully without it, just with
# less-current context. Defaults to the cheapest "sonar" model if PERPLEXITY_MODEL unset.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
